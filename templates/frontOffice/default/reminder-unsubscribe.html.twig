{% extends 'base.html.twig' %}

{% block body %}
    <section class="container my-12 flex flex-col items-center gap-6 text-center">
        {% if unsubscribed %}
            <h1 class="h2">{{ 'Reminders stopped'|abandoned_cart_reminder_trans }}</h1>
            <p class="text-lg font-medium">
                {{ 'You will not receive any more reminders about the carts you leave behind.'|abandoned_cart_reminder_trans }}
            </p>
        {% else %}
            <h1 class="h2">{{ 'This link is no longer valid'|abandoned_cart_reminder_trans }}</h1>
            <p class="text-lg font-medium">
                {{ 'This unsubscribe link is invalid or has already been used. Nothing has been changed.'|abandoned_cart_reminder_trans }}
            </p>
        {% endif %}

        <a href="{{ url('index') }}" class="btn">{{ 'Back to the shop'|abandoned_cart_reminder_trans }}</a>
    </section>
{% endblock %}
