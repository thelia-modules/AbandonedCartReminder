    <fullnamespace>AbandonedCartReminder\AbandonedCartReminder</fullnamespace>
    <descriptive locale="en_US">
        <title>Abandoned Carts Reminder</title>
        <description>Detects carts left behind, mails up to three reminders carrying a signed link
            back to the cart, and reports what those reminders brought back.</description>
    </descriptive>
    <descriptive locale="fr_FR">
        <title>Rappel des Paniers Abandonnés</title>
        <description>Détecte les paniers laissés en plan, envoie jusqu'à trois relances portant un
            lien signé qui ramène au panier, et rapporte ce que ces relances ont fait revenir.</description>
    </descriptive>
